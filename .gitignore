node_modules
# Keep environment variables out of version control.
#
# `.env` alone matches ONLY a file named exactly .env — it does not match
# .env.local, which is how a real Resend key and the Supabase service-role
# key ended up in the first commit. Match every variant, then re-admit the
# example file.
.env
.env.*
!.env.example

/lib/generated/prisma

# ── Agent / IDE skill docs ──
# Prisma ships ~90 files of reference material that the CLI installs. It's
# documentation, not source, and skills-lock.json (kept) is enough to restore
# it — so the repo doesn't need to carry it. .claude/skills and
# .windsurf/skills are just symlinks into .agents.
.agents/
.claude/skills/
.windsurf/skills/

# ── Editor settings ──
# Personal preferences, not project config.
.idea/
.vscode/
*.swp
*.swo

# ── Local-only agent config ──
.claude/settings.local.json
# Dev-server launch config for the agent's browser preview. Points at a
# local port and is regenerated on demand, so it's machine state.
.claude/launch.json

# ── Build output & tooling ──
# This repo is separate from the parent, so it can't inherit its rules.
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel
.netlify

/bundle/
/release.tar.gz
# ── OS noise ──
.DS_Store
Thumbs.db

# ── Debug logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
