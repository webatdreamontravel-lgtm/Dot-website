{
  "name": "dot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3009",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3009",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:check": "tsx --env-file=.env.local scripts/test-connection.ts",
    "db:test-capacity": "node --env-file=.env.local scripts/test-capacity.mjs",
    "db:load-test": "node --env-file=.env.local scripts/load-test.mjs",
    "db:seed": "tsx --env-file=.env.local prisma/seed.ts",
    "make-admin": "tsx --env-file=.env.local scripts/make-admin.ts",
    "test:seed": "tsx --env-file=.env.local scripts/seed-test-trips.ts",
    "test:reset": "tsx --env-file=.env.local scripts/reset-test-trips.ts",
    "test:state": "node --env-file=.env.local scripts/payment-state.mjs",
    "test:webhook": "node --env-file=.env.local scripts/replay-webhook.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.469.0",
    "next": "16.2.4",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "razorpay": "^2.9.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
