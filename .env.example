# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit the filled version.
# Supabase → Project Settings → Database / API
# ─────────────────────────────────────────────────────────────

# Pooled connection (Transaction pooler, port 6543). Used by the APP at
# runtime. pgbouncer=true is required or prepared statements will break.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432). Used by the Prisma CLI for migrations only.
# Migrations cannot run through the transaction pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Supabase Auth / Storage ──
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Server-only. Bypasses RLS entirely. Must never appear in a NEXT_PUBLIC_ var.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── Razorpay ──
# Leave blank until KYC clears; trips default to razorpayEnabled = false,
# so the app records booking requests instead and nothing breaks.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Email ──
# Which provider carries every email the app sends: "resend" or "ses".
# It is a whole-deployment switch, not per-message — flip it and everything
# (booking confirmations, signup verification, admin alerts) moves together.
# Unset behaves as "resend", which is what this app did before SES existed.
EMAIL_PROVIDER="resend"

# Used by both providers. With SES the address must be a verified identity,
# or belong to a verified domain.
EMAIL_FROM="Dream On Travel <bookings@dreamontravel.in>"
ADMIN_NOTIFICATION_EMAIL="hello@dreamontravel.in"

# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=""

# ── AWS (trip photos on S3, and SES when EMAIL_PROVIDER=ses) ──
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="dot-website-media-dev"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
NEXT_PUBLIC_MAX_UPLOAD_MB="10"
NEXT_PUBLIC_MAX_STORED_MB="5"


NEXT_PUBLIC_CLARITY_PROJECT_ID=""

NEXT_PUBLIC_GA_ID=""

# ── App ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Shared secret for scheduled jobs (hold reaper, instalment reminders).
CRON_SECRET=""

# ── Rate limiting ──
RATE_LIMIT_ENABLED="true"

RATE_LIMIT_EMAIL_PER_ADDRESS="5"            # per email address
RATE_LIMIT_EMAIL_PER_ADDRESS_WINDOW="3600"  # seconds
RATE_LIMIT_EMAIL_PER_IP="20"                # per IP, across all addresses
RATE_LIMIT_EMAIL_PER_IP_WINDOW="3600"

# Password and one-time-code attempts. An 8-digit code is brute-forceable
# given unlimited guesses.
RATE_LIMIT_AUTH_ATTEMPTS="10"
RATE_LIMIT_AUTH_WINDOW="900"

# The "is this email taken?" probe on the signup form. Generous for a human
# filling in one form, useless for walking a customer list.
RATE_LIMIT_PROBE="30"
RATE_LIMIT_PROBE_WINDOW="60"

# How long spent windows are kept before /api/cron/rate-limit-cleanup removes
# them. Only needs to exceed the longest window above.
RATE_LIMIT_RETENTION_DAYS="2"
